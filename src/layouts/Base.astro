---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title: string; description: string; image?: ImageMetadata; schema?: object | object[]; noindex?: boolean; }
const { title, description, image, schema, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const full = title.includes(site.name) ? title : `${title} | ${site.name}`;
const og = image ? new URL((await import('astro:assets').then((m) => m.getImage({ src: image, width: 1200, format: 'jpeg' }))).src, site.domain).href : undefined;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.domain,
  description: 'Custom aquarium, terrarium and aquatic environment manufacturer.',
};
const graphs = [org, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0a0b0c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={full} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />{og && <meta property="og:image" content={og} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500&display=swap" />
  {graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  {site.analyticsId && <slot name="analytics" />}
</head>
<body>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>import '../scripts/site';</script>
</body>
</html>
