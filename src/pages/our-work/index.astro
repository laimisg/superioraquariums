---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { projectCategories } from '../../data/categories';
import { photos } from '../../data/photos';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const used = projectCategories.filter((c) => projects.some((p) => p.data.categories.includes(c)));
---
<Base title="Our Work — Custom Aquarium & Terrarium Portfolio" description="Explore a portfolio of custom aquariums, terrariums, reef systems, paludariums and water features for residential, commercial and hospitality spaces." image={photos.display.src}>
  <section class="section" style="padding-top:11rem">
    <div class="wrap">
      <SectionHead eyebrow="Our Work" title="A portfolio of custom environments." lead="Filter by project type or category. Each project opens as a full case study." />
      <div class="filters" role="group" aria-label="Filter projects">
        <button aria-pressed="true" data-f="all">All</button>
        {used.map((c) => <button aria-pressed="false" data-f={c}>{c}</button>)}
      </div>
      <div class="cards" id="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
      <p class="empty" id="none" hidden>No projects in this category yet.</p>
    </div>
  </section>
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('[data-card]');
  const none = document.getElementById('none')!;
  const apply = (f: string) => {
    let n = 0;
    cards.forEach((c) => { const ok = f === 'all' || (c.dataset.cats ?? '').split('|').includes(f); c.hidden = !ok; if (ok) { n++; c.classList.add('in'); } });
    none.hidden = n > 0;
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
    history.replaceState(null, '', f === 'all' ? location.pathname : `#${encodeURIComponent(f)}`);
  };
  btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.f!)));
  const h = decodeURIComponent(location.hash.slice(1));
  if (h && [...btns].some((b) => b.dataset.f === h)) apply(h);
</script>
